# Copy to .env and fill in your key:  cp .env.example .env
# Get your key from https://app.dehashed.com/profile (refresh it once for v2).
DEHASHED_API_KEY=

# --- HackNotice Research API (for hacknoticequery.py) ---
# Access is for approved accounts only; contact HackNotice first.
# Preferred: a single integration key.
HACKNOTICE_INTEGRATION_KEY=
# Or JWT sign-in (leave the integration key blank to use these):
HACKNOTICE_API_KEY=
HACKNOTICE_EMAIL=
HACKNOTICE_PASSWORD=
